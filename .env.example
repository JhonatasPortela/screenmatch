# Copie este arquivo para .env e ajuste os valores localmente.
# NUNCA commite o arquivo .env no Git.

# --- PostgreSQL (Docker) ---
POSTGRES_DB=portela_series
POSTGRES_USER=screenmatch
POSTGRES_PASSWORD=defina_uma_senha_local
POSTGRES_PORT=5432

# --- Spring Boot (devem bater com o Postgres acima) ---
DB_HOST=localhost
DB_NAME=portela_series
DB_USER=screenmatch
DB_PASSWORD=defina_uma_senha_local
